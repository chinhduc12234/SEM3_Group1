# Copy to .env and replace placeholders, or run scripts/init-dev.ps1 for random local secrets.
SQL_SA_PASSWORD=CHANGE_ME_StrongSqlPassword!
WEB_PORT=8080
# Change if Windows reserves port 1433. Internal service connections still use sqlserver:1433.
SQL_PORT=1433
# Run init-dev.ps1 to generate these values. Never use the placeholders as credentials.
ADMIN_EMAIL=admin@giveaid.local
ADMIN_PASSWORD=GENERATE_WITH_INIT_DEV
IDENTITY_DB_PASSWORD=GENERATE_WITH_INIT_DEV
ORGANIZATION_DB_PASSWORD=GENERATE_WITH_INIT_DEV
INTERNAL_API_KEY=GENERATE_WITH_INIT_DEV

# Organization emails: enable only after configuring both templates and EmailJS Account > Security.
# Keep real credentials in .env, never in frontend/NEXT_PUBLIC_* or Git.
EMAILJS_ENABLED=false
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_SUBMITTED_TEMPLATE_ID=
EMAILJS_REVIEW_TEMPLATE_ID=
EMAILJS_SUPPORT_EMAIL=
EMAILJS_WEBSITE_URL=http://localhost:8080

CAMPAIGN_DB_PASSWORD=GENERATE_WITH_INIT_DEV

# Browser key: restrict HTTP referrers and enable Maps JavaScript API and Routes API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

NOTIFICATION_DB_PASSWORD=GENERATE_WITH_INIT_DEV
NOTIFICATIONS_ENABLED=true
# Realtime inbox works with Firebase disabled. Each developer supplies private credentials locally.
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_PUBLIC_KEY=
# Credential file: .secrets/firebase/firebase-admin.json (never commit).
WEBSITE_URL=http://localhost:8080
